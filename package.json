{
  "name": "factory-live",
  "version": "0.2.0",
  "private": true,
  "description": "La factory Hermès en temps réel : ligne d'usine, agents, modèles, interventions.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w @factory-live/web",
    "typecheck": "tsc -b && tsc -b apps/web && tsc -p tsconfig.config.json && tsc -p e2e/tsconfig.json && tsc -p site/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:text": "node scripts/check-text.mjs",
    "check:arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev:web": "npm run dev -w @factory-live/web",
    "dev:server": "npm run dev -w @factory-live/server",
    "capture:incident": "node scripts/capture-incident.mjs",
    "verify:fast": "npm run format:check && npm run lint && npm run lint:css && npm run typecheck && npm run check:text && npm run check:arch && npm run test:coverage",
    "verify": "npm run verify:fast && npm run build",
    "lint:css": "stylelint \"apps/web/src/**/*.css\" \"site/src/**/*.css\"",
    "e2e": "playwright test",
    "e2e:captures": "playwright test --project=captures-bureau --project=captures-iphone",
    "site:build": "node site/build.mjs",
    "site:preview": "node site/serve.mjs",
    "site:test": "node --test site/test/structure.test.mjs && playwright test -c site/playwright.config.ts",
    "site:captures": "node site/capture.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@primer/stylelint-config": "13.6.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-primer-react": "9.3.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "stylelint": "16.26.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "stylelint-browser-compat": {
      "zod": "4.6.7"
    }
  }
}
