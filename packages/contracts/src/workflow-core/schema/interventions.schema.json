{
  "$defs": {
    "CodedText": {
      "description": "A text of factory-live's catalogue: its code and its parameters.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "code"
      ],
      "title": "CodedText",
      "type": "object"
    },
    "CopyAction": {
      "description": "A command to copy, written by the runtime's adapter, and its label.",
      "properties": {
        "kind": {
          "const": "copy",
          "default": "copy",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/CodedText"
        },
        "command": {
          "title": "Command",
          "type": "string"
        }
      },
      "required": [
        "label",
        "command"
      ],
      "title": "CopyAction",
      "type": "object"
    },
    "GestureAction": {
      "description": "A gesture the workflow declares, that applies to the card (`unblock`): the client posts it.",
      "properties": {
        "kind": {
          "const": "gesture",
          "default": "gesture",
          "title": "Kind",
          "type": "string"
        },
        "gesture": {
          "title": "Gesture",
          "type": "string"
        }
      },
      "required": [
        "gesture"
      ],
      "title": "GestureAction",
      "type": "object"
    },
    "Intervention": {
      "description": "A point where the workflow waits for its owner.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "needs_input",
            "capability",
            "transient",
            "gave_up",
            "triage_loop",
            "held_active_pr"
          ],
          "title": "Kind",
          "type": "string"
        },
        "item": {
          "title": "Item",
          "type": "string"
        },
        "event": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event"
        },
        "opened_at": {
          "title": "Opened At",
          "type": "string"
        },
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agent"
        },
        "severity": {
          "enum": [
            "critical",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "push": {
          "title": "Push",
          "type": "boolean"
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodedText"
            },
            {
              "$ref": "#/$defs/QuotedText"
            }
          ],
          "title": "Title"
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodedText"
            },
            {
              "$ref": "#/$defs/QuotedText"
            }
          ],
          "title": "Question"
        },
        "actions": {
          "items": {
            "discriminator": {
              "mapping": {
                "copy": "#/$defs/CopyAction",
                "gesture": "#/$defs/GestureAction",
                "link": "#/$defs/LinkAction"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/GestureAction"
              },
              {
                "$ref": "#/$defs/CopyAction"
              },
              {
                "$ref": "#/$defs/LinkAction"
              }
            ]
          },
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "item",
        "event",
        "opened_at",
        "agent",
        "severity",
        "push",
        "title",
        "question",
        "actions"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "LinkAction": {
      "properties": {
        "kind": {
          "const": "link",
          "default": "link",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/CodedText"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "LinkAction",
      "type": "object"
    },
    "QuotedText": {
      "description": "The agent's own words, as written.",
      "properties": {
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "quote"
      ],
      "title": "QuotedText",
      "type": "object"
    }
  },
  "description": "GET /api/workflows/<key>/interventions: the open interventions of the workflow's board, by opening time.",
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workflow": {
      "title": "Workflow",
      "type": "string"
    },
    "interventions": {
      "items": {
        "$ref": "#/$defs/Intervention"
      },
      "title": "Interventions",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "workflow",
    "interventions"
  ],
  "title": "InterventionsResponse",
  "type": "object"
}
