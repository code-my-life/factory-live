{
  "$defs": {
    "ActivityFact": {
      "description": "One recent fact of a board: a tool call and its outcome, a model call, a card's event, a guard's refusal.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "at": {
          "title": "At",
          "type": "string"
        },
        "kind": {
          "enum": [
            "tool",
            "llm",
            "kanban",
            "guard",
            "system"
          ],
          "title": "Kind",
          "type": "string"
        },
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agent"
        },
        "item": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Item"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "running",
                "error",
                "blocked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        }
      },
      "required": [
        "id",
        "at",
        "kind",
        "agent",
        "item",
        "text",
        "status"
      ],
      "title": "ActivityFact",
      "type": "object"
    },
    "AgentLive": {
      "description": "The live state of an agent holding a card in progress.",
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "item": {
          "title": "Item",
          "type": "string"
        },
        "run": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run"
        },
        "state": {
          "enum": [
            "thinking",
            "tool",
            "cli",
            "blocked"
          ],
          "title": "State",
          "type": "string"
        },
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "lane_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lane Model"
        },
        "heartbeat_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Heartbeat At"
        }
      },
      "required": [
        "agent",
        "item",
        "run",
        "state",
        "action",
        "model",
        "lane_model",
        "heartbeat_at"
      ],
      "title": "AgentLive",
      "type": "object"
    },
    "CardEvent": {
      "description": "One event of a card's life (created, claimed, blocked...): its payload a JSON object, empty when absent or\nunreadable. Dates are Unix seconds.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "created_at": {
          "title": "Created At",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "run_id",
        "kind",
        "payload",
        "created_at"
      ],
      "title": "CardEvent",
      "type": "object"
    },
    "CodedText": {
      "description": "A text of factory-live's catalogue: its code and its parameters.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "code"
      ],
      "title": "CodedText",
      "type": "object"
    },
    "Comment": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "author": {
          "title": "Author",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "author",
        "body",
        "created_at"
      ],
      "title": "Comment",
      "type": "object"
    },
    "CopyAction": {
      "description": "A command to copy, written by the runtime's adapter, and its label.",
      "properties": {
        "kind": {
          "const": "copy",
          "default": "copy",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/CodedText"
        },
        "command": {
          "title": "Command",
          "type": "string"
        }
      },
      "required": [
        "label",
        "command"
      ],
      "title": "CopyAction",
      "type": "object"
    },
    "GestureAction": {
      "description": "A gesture the workflow declares, that applies to the card (`unblock`): the client posts it.",
      "properties": {
        "kind": {
          "const": "gesture",
          "default": "gesture",
          "title": "Kind",
          "type": "string"
        },
        "gesture": {
          "title": "Gesture",
          "type": "string"
        }
      },
      "required": [
        "gesture"
      ],
      "title": "GestureAction",
      "type": "object"
    },
    "Intervention": {
      "description": "A point where the workflow waits for its owner.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "needs_input",
            "capability",
            "transient",
            "gave_up",
            "triage_loop",
            "held_active_pr"
          ],
          "title": "Kind",
          "type": "string"
        },
        "item": {
          "title": "Item",
          "type": "string"
        },
        "event": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Event"
        },
        "opened_at": {
          "title": "Opened At",
          "type": "string"
        },
        "agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Agent"
        },
        "severity": {
          "enum": [
            "critical",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "push": {
          "title": "Push",
          "type": "boolean"
        },
        "title": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodedText"
            },
            {
              "$ref": "#/$defs/QuotedText"
            }
          ],
          "title": "Title"
        },
        "question": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodedText"
            },
            {
              "$ref": "#/$defs/QuotedText"
            }
          ],
          "title": "Question"
        },
        "actions": {
          "items": {
            "discriminator": {
              "mapping": {
                "copy": "#/$defs/CopyAction",
                "gesture": "#/$defs/GestureAction",
                "link": "#/$defs/LinkAction"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/GestureAction"
              },
              {
                "$ref": "#/$defs/CopyAction"
              },
              {
                "$ref": "#/$defs/LinkAction"
              }
            ]
          },
          "title": "Actions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "item",
        "event",
        "opened_at",
        "agent",
        "severity",
        "push",
        "title",
        "question",
        "actions"
      ],
      "title": "Intervention",
      "type": "object"
    },
    "InterventionClosed": {
      "description": "The state of an `intervention_closed` event: the intervention gone.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "InterventionClosed",
      "type": "object"
    },
    "Item": {
      "description": "What a workflow moves forward, with its full state. At this stage, each card is its own item (ADR 0016).",
