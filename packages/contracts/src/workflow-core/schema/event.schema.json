    "LinkAction": {
      "properties": {
        "kind": {
          "const": "link",
          "default": "link",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/CodedText"
        },
        "url": {
          "title": "Url",
