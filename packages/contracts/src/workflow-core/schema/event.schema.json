        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "LinkAction",
      "type": "object"
    },
    "LiveAction": {
      "description": "What the agent is doing: a tool call (`tool`), a delegated command line (`cli`, its label the command's name),\nor waiting for the model (`llm`). `detail`: the command, the path or the name given to the tool, secrets masked,\n2 000 characters at most; for `llm`, the model.",
      "properties": {
        "kind": {
          "enum": [
            "llm",
            "tool",
            "cli"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label",
        "detail",
        "started_at"
      ],
      "title": "LiveAction",
      "type": "object"
    },
    "LiveModel": {
      "description": "The agent's model. `source`: `live` for a served model read in the agent's journal, `session` for the model\nits session notes (which may be the one asked for, not the one served).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider"
        },
        "source": {
          "enum": [
            "live",
            "session"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "provider",
        "source"
      ],
      "title": "LiveModel",
      "type": "object"
    },
    "MachineCheck": {
      "description": "One tile of the machine's state.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "degraded",
            "down",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "object"
        },
        "checked_at": {
          "title": "Checked At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "group",
        "status",
        "detail",
        "checked_at"
      ],
      "title": "MachineCheck",
      "type": "object"
    },
    "QuotedText": {
      "description": "The agent's own words, as written.",
      "properties": {
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "quote"
      ],
      "title": "QuotedText",
      "type": "object"
    },
    "Run": {
      "description": "One run of a card: who worked on it, how it ended. Dates are Unix seconds.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Profile"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Outcome"
        },
        "started_at": {
          "title": "Started At",
          "type": "integer"
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ended At"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Summary"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "profile",
        "status",
        "outcome",
        "started_at",
        "ended_at",
        "summary",
        "metadata"
      ],
      "title": "Run",
      "type": "object"
    }
  },
  "description": "One event of GET /api/events. `reset` opens an epoch: the client reads the full state again; it names no\nworkflow, no item and carries no state. `changed` carries the full state of the item, `live` the live state of an\nagent (its item: the card it holds), `activity` one new fact of the board, `machine` the full list of the machine's\nchecks when a status changed (no workflow, no item), `intervention_opened` an intervention that opened (its item:\nthe card), `intervention_closed` the id of one that closed.",
  "properties": {
    "cursor": {
      "title": "Cursor",
      "type": "string"
    },
    "workflow": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Workflow"
    },
    "item": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Item"
    },
    "kind": {
      "enum": [
        "changed",
        "reset",
        "live",
        "activity",
        "machine",
        "intervention_opened",
        "intervention_closed"
      ],
      "title": "Kind",
      "type": "string"
    },
    "at": {
      "title": "At",
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "$ref": "#/$defs/Item"
        },
        {
          "$ref": "#/$defs/AgentLive"
        },
        {
          "$ref": "#/$defs/ActivityFact"
        },
        {
          "items": {
            "$ref": "#/$defs/MachineCheck"
          },
          "type": "array"
        },
        {
          "$ref": "#/$defs/Intervention"
        },
        {
          "$ref": "#/$defs/InterventionClosed"
        },
        {
          "type": "null"
        }
      ],
      "title": "State"
    }
  },
  "required": [
    "cursor",
    "workflow",
    "item",
    "kind",
    "at",
    "state"
  ],
  "title": "StreamEvent",
  "type": "object"
}
