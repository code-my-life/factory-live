        "title",
        "body",
        "status",
        "assignee",
        "created_at",
        "started_at",
        "completed_at",
        "block_kind",
        "idempotency_key",
        "workspace_path",
        "current_run_id",
        "last_heartbeat_at",
        "model_override",
        "provider_override",
        "skills",
        "runs",
        "parents",
        "children",
        "comments",
