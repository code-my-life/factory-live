# Copier en docker/.env (ignoré par git) et y mettre les vraies valeurs de ce PC : elles n'entrent
# jamais dans le dépôt. Sans docker/.env, factory-live ne répond qu'à ce PC (http://localhost:8446).
#
# Login Tailscale autorisé à écrire depuis les autres appareils (en-tête Tailscale-User-Login),
# par exemple <login>@github ; vide : écritures depuis ce PC seulement.
TAILSCALE_LOGINS=
# Origines de la PWA : ce PC, puis l'adresse tailnet de `tailscale serve --https=8446`, par exemple
# http://localhost:8446,https://<machine>.<tailnet>.ts.net:8446
PUBLIC_ORIGINS=http://localhost:8446
# Adresse tailnet du dashboard d'Hermès, pour le lien des interventions ; vide : pas de lien.
DASHBOARD_URL=
# Hôtes acceptés en plus de ce PC et des origines (nom:port), par exemple si le port publié change.
ALLOWED_HOSTS=
LOG_LEVEL=info
